<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the full logo inside Android 12's splash-icon safe area. -->
    <item
        android:left="48dp"
        android:top="48dp"
        android:right="48dp"
        android:bottom="48dp">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash" />
    </item>
</layer-list>
